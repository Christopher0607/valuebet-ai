node_modules/
dist/
*.db
*.db-journal
# WAL 模式的两个附属文件。models.py 改成 journal_mode=WAL 之后，SQLite 不再
# 生成 .db-journal，改为生成 -wal 和 -shm，而上面两条规则一个都盖不住它们。
# 后果是 -wal（里面就是数据库页，含 real_bets 和 user_settings）被提交进了
# **公开仓库**。加规则的同时要 git rm --cached，光加规则对已跟踪的文件无效。
*.db-wal
*.db-shm
__pycache__/
*.pyc
.DS_Store
.env

# 走查产出的中间预测表（几十 MB，可由脚本重跑生成）
backend/training/validation/*.parquet
backend/training/validation/dev_tuning_results.csv

# 并行代理的 git worktree —— 每个都是本仓库的一份完整副本（15MB+），
# 提交进来等于把仓库套娃塞进自己。纯本地临时目录，用完即弃。
.claude/worktrees/
